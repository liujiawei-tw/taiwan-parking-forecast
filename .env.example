# Local development environment template.
# Copy this file to .env and fill values locally.
# Never commit real API keys, client secrets, database passwords, or tokens.

# App
APP_ENV=local
APP_PORT=8080
WEB_PORT=5173

# Database
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=taiwan_parking_forecast
MYSQL_USER=parking_app
MYSQL_PASSWORD=change-me-locally

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Google Maps Platform
GOOGLE_MAPS_BROWSER_API_KEY=replace-with-local-browser-key
GOOGLE_ROUTES_SERVER_API_KEY=replace-with-local-server-key

# Government / TDX sources
TDX_CLIENT_ID=replace-with-local-client-id
TDX_CLIENT_SECRET=replace-with-local-client-secret
NTPC_API_BASE_URL=https://data.ntpc.gov.tw

# Runtime controls
PARKING_DATA_STALE_AFTER_SECONDS=300
SOURCE_REFRESH_MIN_INTERVAL_SECONDS=300
