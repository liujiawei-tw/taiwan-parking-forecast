# App
# 目前僅作環境標籤；Spring 預設 profile 為 local，Compose 固定使用 docker。
APP_ENV=local
# 範例值為 API 的本機 port；目前程式讀取 SERVER_PORT，Compose 固定使用 8080。
APP_PORT=8080
# Vite 預設開發 port；目前 vite.config.js 未讀取 WEB_PORT。
WEB_PORT=5173

# Database
# 本機資料庫工具的慣例連線值；Compose 使用內部主機 mysql 與固定資料庫設定。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=taiwan_parking_forecast
MYSQL_USER=parking_app
# 尚未接線：目前程式與 Compose 均不讀取此欄位。
MYSQL_PASSWORD=

# Redis
# 本機 Redis 慣例連線值；Compose API 使用服務名稱 redis 與內部 port 6379。
REDIS_HOST=localhost
REDIS_PORT=6379

# Google Maps Platform
# 舊名稱，目前前端不讀取；瀏覽器實際使用 VITE_GOOGLE_MAPS_BROWSER_API_KEY。
GOOGLE_MAPS_BROWSER_API_KEY=
# Server key 僅供後端 Routes API；外部呼叫預設停用。
GOOGLE_ROUTES_SERVER_API_KEY=
GOOGLE_ROUTES_EXTERNAL_CALLS_ENABLED=false
GOOGLE_ROUTES_TIMEOUT=10s
GOOGLE_ROUTES_ROUTING_PREFERENCE=TRAFFIC_AWARE_OPTIMAL

# Government / TDX Sources
# TDX 認證預留欄位；目前主系統尚無引用，未設定時保持空白。
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# 目前後端讀取 NTPC_OPEN_DATA_BASE_URL（預設相同）；此舊名稱尚未接線。
NTPC_API_BASE_URL=https://data.ntpc.gov.tw

# Runtime Controls
# 訓練／新鮮度控制預留值；目前主系統未讀取這兩個名稱。
PARKING_DATA_STALE_AFTER_SECONDS=300
# 目前來源冷卻設定名稱為 PARKING_REFRESH_SOURCE_COOLDOWN，預設 5m；此名稱尚未接線。
SOURCE_REFRESH_MIN_INTERVAL_SECONDS=300

# Docker Compose
# Compose 必填；請部署時改成與 root 密碼不同的長隨機值。
PARKING_DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
# Web 只綁定主機 loopback 的 HTTP port。
WEB_HTTP_PORT=18088
# Browser key 會編入前端 bundle；僅使用受限 key，限制 referrer 網域與可用 API。
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
