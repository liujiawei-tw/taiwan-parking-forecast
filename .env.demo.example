# 複製為未追蹤的 .env.demo，填入部署環境值；不要把真實值提交或貼到 log。
PARKING_DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
DEMO_HTTP_PORT=18088

# 瀏覽器 key 會進前端 bundle，必須在 Google Cloud 限制正式網域 referrer 與所需 API。
VITE_GOOGLE_MAPS_BROWSER_API_KEY=

# Routes key 僅注入 API 容器。沒有有效 key 時保持停用，不會有真實 ETA。
GOOGLE_ROUTES_SERVER_API_KEY=
GOOGLE_ROUTES_EXTERNAL_CALLS_ENABLED=false
GOOGLE_ROUTES_TIMEOUT=10s
GOOGLE_ROUTES_ROUTING_PREFERENCE=TRAFFIC_AWARE_OPTIMAL
